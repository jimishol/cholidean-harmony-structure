# Ignore everything inside midi_files
midi_files/*
soundfonts/*

# Keep the directory itself (required for re-includes to work reliably)
!midi_files/
!soundfonts/
!soundfonts/readme.md

# Allow only this specific file in midi_files
!midi_files/beethoven_symphony_5_1_(c)galimberti.mid

# Sandbox build artifacts under asset_pipeline/udpMidi
asset_pipeline/udpMidi/node_modules/
asset_pipeline/udpMidi/udp-midi-bridge
asset_pipeline/udpMidi/udp-midi-bridge-*
asset_pipeline/udpMidi/dist/

# All other node_modules (just in case)
**/node_modules/

# OS cruft and logs
.DS_Store
Thumbs.db
npm-debug.log*
*.log
